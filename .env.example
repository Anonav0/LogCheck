# ==============================================================================
# LogLens AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local configuration:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Application Settings
APP_NAME="LogLens AI"
APP_ENV="development"
DEBUG=false

# Log Processing Limits
MAX_LOG_SIZE_BYTES=1048576
MAX_LOG_LINES=20000
MAX_LOG_LINE_LENGTH=16384
ALLOW_PARTIAL_ANALYSIS=false

# LLM Integration Settings (Disabled by default; credentials optional)
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_FAILURE_GROUPS=10
LLM_MAX_EVIDENCE_LINES=80
LLM_MAX_PROMPT_CHARS=30000


